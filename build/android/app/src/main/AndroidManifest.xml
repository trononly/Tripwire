<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission for WebView -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Observe network connectivity / type for android:NetworkChanged events -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Historical M-Pesa SMS import: runtime permission, requested on first
         use. No SEND_SMS/WRITE_SMS — this app never sends or alters messages. -->
    <!-- Direct USSD calls from the M-Pesa shortcut: runtime permission,
         requested on first use. The session UI stays in the system phone
         app; this app never sees keypresses or the PIN. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Always-on M-Pesa catcher: runtime permission, requested with the
         transact button. Sender-checked and queue-only. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Identifies which SIM delivered each M-Pesa SMS (slot + carrier name)
         so dual-SIM phones keep one wallet record per SIM. Requested with
         READ_SMS; optional — a denial still imports as a single wallet. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Accessibility automation is a sensitive permission: no runtime grant
         exists, the user opts in via system Settings (see the in-app
         disclosure). The manifest entry only makes the service offerable. -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TripwireApp"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".WailsForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- M-Pesa menu stepper (off by default; user enables it in system
             Settings after reading the in-app disclosure). Arms only on an
             in-app Send/Pay tap, fills the *334# prompts, stops at the PIN. -->
        <service
            android:name=".MpesaUssdService"
            android:exported="true"
            android:label="@string/ussd_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ussd_service_config" />
        </service>

        <!-- M-Pesa catcher: always on, sender-checked, queue-only. The
             BROADCAST_SMS guard means only the system telephony stack can
             deliver to it. Bodies are queued, never parsed here. -->
        <receiver
            android:name=".SmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
