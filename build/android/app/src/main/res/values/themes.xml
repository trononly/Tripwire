<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TripwireApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/tripwire_red</item>
        <item name="colorPrimaryVariant">@color/tripwire_red_dark</item>
        <item name="colorOnPrimary">@color/tripwire_text</item>
        <!-- System bars match the app background (white / #09090B), not the
             darker charcoal splash colour. The JS bridge updates these again
             when the in-app Light/Dark setting differs from the system. -->
        <item name="android:statusBarColor">@color/tripwire_system_bar</item>
        <item name="android:navigationBarColor">@color/tripwire_system_bar</item>
        <item name="android:windowLightStatusBar">@bool/tripwire_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/tripwire_light_system_bars</item>
        <!-- No gray system scrim over the app's own background. -->
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <!-- Window background: branded launch drawable, which also covers
             the WebView first-paint flash. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12+ splash: Tripwire background + launcher icon.
             Ignored on older releases. -->
        <item name="android:windowSplashScreenBackground">@color/tripwire_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
