<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TripwireApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/tripwire_red</item>
        <item name="colorPrimaryVariant">@color/tripwire_red_dark</item>
        <item name="colorOnPrimary">@color/tripwire_text</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/tripwire_bg</item>
        <item name="android:navigationBarColor">@color/tripwire_bg</item>
        <!-- Window background: branded launch drawable, which also covers
             the WebView first-paint flash. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12+ splash: Tripwire background + launcher icon.
             Ignored on older releases. -->
        <item name="android:windowSplashScreenBackground">@color/tripwire_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
